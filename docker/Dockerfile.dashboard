# Dashboard: build with Node, serve with nginx (which also proxies /v1, /ws and /healthz to the API)
FROM node:20-alpine AS build
WORKDIR /ui
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY dashboard/ ./
ARG VITE_API_KEY
ENV VITE_API_KEY=$VITE_API_KEY
# npm run build = tsc -b && vite build from the installed packages (npx would download unrelated ones if missing)
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist /usr/share/nginx/html
EXPOSE 80
