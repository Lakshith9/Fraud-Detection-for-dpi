# Copy to .env and adjust. Docker Compose overrides REDIS_URL / DATABASE_URL with service hostnames.
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://fraud:fraud@localhost:5432/fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fraud

# Operator API keys: comma separated "operator_id:key". Generate keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
OPERATOR_API_KEYS=alice:replace-with-a-generated-key,bob:replace-with-another-key
# Key the dashboard uses (must be one of the keys above)
VITE_API_KEY=replace-with-a-generated-key

STREAM_PARTITIONS=2
SEQUENCE_TIMEOUT_MS=25
GRAPH_INTERVAL_S=20
GRAPH_STALE_AFTER_S=300
GRAPH_BACKEND=networkx
MODEL_POLL_INTERVAL_S=5
RETRAIN_INTERVAL_HOURS=24
RETRAIN_MIN_FEEDBACK=50
RETRAIN_TOLERANCE=0.01
LOG_LEVEL=INFO

# Live Mojaloop switch (pipeline.mojaloop_consumer / docker-compose.mojaloop.yml).
# Unset = localhost:9092 natively, kafka:29092 (the harness broker) under docker-compose.mojaloop.yml.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MOJALOOP_PREPARE_TOPIC=topic-transfer-prepare
MOJALOOP_CONSUMER_GROUP=fraud-engine
MOJALOOP_OFFSET_RESET=latest
# Replay only (simulator/mojaloop_sender.py): score replayed transfers at their original event time, carried in the
# FSP's eventTime extension. Keep false for live traffic.
TRUST_FSP_EVENT_TIME=false
